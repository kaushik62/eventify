# Server
NODE_ENV=development
CLIENT_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000

# PostgreSQL
POSTGRES_USER=eventify
POSTGRES_PASSWORD=eventify
POSTGRES_DB=eventify

# Database
# For the backend running in Docker Compose, use:
DATABASE_URL=postgresql://eventify:eventify@postgres:5432/eventify
# For local app runs outside Docker, use:
# DATABASE_URL=postgresql://eventify:eventify@localhost:5432/eventify

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=eventify-event-images

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
